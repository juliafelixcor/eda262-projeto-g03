  # module.data_lake.aws_athena_named_query.negocio_refined will be created
  + resource "aws_athena_named_query" "negocio_refined" {
      + database    = "eda262_g03_refined"
      + description = "Preco medio por periodo de partida/chegada (camada refined)"
      + id          = (known after apply)
      + name        = "eda262-g03-negocio-refined"
      + query       = <<-EOT
            -- Pergunta de negócio: o valor das passagens é influenciado pelo
            -- horário de embarque e desembarque?
            -- Média ponderada recomposta a partir da refined (soma_preco / qtd),
            -- portanto o resultado é idêntico ao AVG(price) da Parte 1.
            SELECT
                departure_time,
                arrival_time,
                SUM(qtd_passagens)                                        AS quantidade_passagens,
                ROUND(CAST(SUM(soma_preco) AS DOUBLE) / SUM(qtd_passagens), 2) AS preco_medio
            FROM eda262_g03_refined.preco_por_periodo
            GROUP BY departure_time, arrival_time
            ORDER BY preco_medio DESC
        EOT
      + workgroup   = (known after apply)
    }

  # module.data_lake.aws_athena_named_query.negocio_trusted will be created
  + resource "aws_athena_named_query" "negocio_trusted" {
      + database    = "eda262_g03_trusted"
      + description = "Mesma pergunta calculada direto na trusted (comparacao de custo)"
      + id          = (known after apply)
      + name        = "eda262-g03-negocio-trusted"
      + query       = <<-EOT
            -- Mesma pergunta calculada direto na trusted (Parquet), para comparar o
            -- volume escaneado com a refined e com o CSV da Parte 1.
            SELECT
                departure_time,
                arrival_time,
                COUNT(*)             AS quantidade_passagens,
                ROUND(AVG(price), 2) AS preco_medio
            FROM eda262_g03_trusted.flights
            GROUP BY departure_time, arrival_time
            ORDER BY preco_medio DESC
        EOT
      + workgroup   = (known after apply)
    }

